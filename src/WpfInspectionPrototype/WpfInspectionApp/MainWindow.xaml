<Window x:Class="WpfInspectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfInspectionApp.ViewModels"
        xmlns:views="clr-namespace:WpfInspectionApp.Views"
        xmlns:fa="clr-namespace:WpfInspectionApp.Services.FlowAlgorithms"
        Title="WPF Vision Inspector Prototype"
        Width="1680"
        Height="980"
        MinWidth="1180"
        MinHeight="720"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackground}">
    <!--
        OS 타이틀바를 우리 TopBar 가 대신 그리도록 WindowChrome 사용. CaptionHeight=50 은
        outer Grid 의 10px top margin + 42px TopBar 높이 (+ TopBar 와 콘텐츠 사이 8px
        gap 의 절반) 합. 이 영역이 드래그 가능 영역이 됨. 개별 인터랙티브 컨트롤은
        WindowChrome.IsHitTestVisibleInChrome="True" 로 클릭을 받게 함.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--
            Theme color brushes (WindowBackground, PanelBackground, PrimaryText, ...)
            moved to App.xaml so floating camera windows can find them too via the
            DynamicResource lookup chain. SetThemeBrush writes to Application.Current.
            Resources accordingly. SystemColors overrides stay at window scope because
            they're meant to override the system's own keyed brush.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#07101C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E4F3FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E5EA8" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" />
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource PrimaryText}"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="8,2,34,2"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="6,2,34,2"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Visibility="Hidden"
                                     Foreground="{DynamicResource PrimaryText}"
                                     Background="{DynamicResource ComboDarkBackground}"
                                     BorderThickness="0"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ComboDarkBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}"
                                        BorderThickness="1">
                                    <ScrollViewer Margin="0"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource ComboDarkHover}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                                <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboDarkHover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboDarkSelected}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TreeGridCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TreeGridNameEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeAlgorithmContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxHeight" Value="460" />
        </Style>

        <Style x:Key="TreeAlgorithmMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid MinWidth="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18"
                                    Height="18"
                                    Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource BorderBlue}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path Data="{Binding IconGeometry}"
                                      Stroke="{Binding IconBrush}"
                                      Fill="Transparent"
                                      StrokeThickness="1.45"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Margin="3" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="{DynamicResource TreeHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TreeExpandToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Content" Value="+" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="GlyphBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlyphBorder" Property="Background" Value="{DynamicResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GlyphBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="-" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="InspectionTreeItem_PreviewMouseRightButtonDown" />
            <!--
                선택된 TreeViewItem 이 ScrollViewer 의 viewport 밖에 있으면 자동으로
                스크롤되어 보이도록. ROI 를 클릭해서 외부에서 IsSelected 가 true 로
                설정될 때도 동작 — 클릭한 노드가 화면에 안 보이면 답답하다는 사용자 피드백.
            -->
            <EventSetter Event="Selected" Handler="InspectionTreeItem_Selected" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Border x:Name="HeaderBorder"
                                    Grid.ColumnSpan="2"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    ContextMenuService.IsEnabled="{Binding HasAlgorithmMenu}">
                                <Border.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.AlgorithmMenuItems, RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource TreeAlgorithmContextMenu}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource TreeAlgorithmMenuItem}" />
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource TreeExpandToggleButton}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="Hidden" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TreeSelectedBackground}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:InspectionTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <Grid Height="23"
                  MinWidth="350"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" MinWidth="72" SharedSizeGroup="WindowListName" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="76" MinWidth="58" SharedSizeGroup="WindowListType" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEnb" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEss" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListGrp" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="46" MinWidth="42" SharedSizeGroup="WindowListGrpId" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="{Binding NamePadding}">
                    <TextBox Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource TreeGridNameEditor}"
                             Visibility="{Binding NameEditorVisibility}">
                        <TextBox.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.AlgorithmMenuItems, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource TreeAlgorithmContextMenu}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource TreeAlgorithmMenuItem}" />
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                    <TextBlock Text="{Binding NameText}"
                               Foreground="{Binding Foreground, TargetNullValue=#EAF6FF, FallbackValue=#EAF6FF}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding NameDisplayVisibility}" />
                </Grid>
                <TextBlock Grid.Column="2"
                           Text="{Binding TypeText}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding GridCellVisibility}" />
                <CheckBox Grid.Column="4"
                          Style="{StaticResource TreeGridCheckBox}"
                          IsChecked="{Binding IsInspectionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding GridCellVisibility}" />
                <CheckBox Grid.Column="6"
                          Style="{StaticResource TreeGridCheckBox}"
                          IsChecked="{Binding IsEssential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding GridCellVisibility}" />
                <CheckBox Grid.Column="8"
                          Style="{StaticResource TreeGridCheckBox}"
                          IsEnabled="{Binding CanEditGroup}"
                          IsChecked="{Binding IsGrouped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding GridCellVisibility}" />
                <TextBlock Grid.Column="10"
                           Text="{Binding GroupId}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="12"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding GroupIdVisibility}" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="RightPanelBorder" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="TreeHeaderSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DockToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="52" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource TreeHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        </Style>

        <Style x:Key="ThemeOptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ChromeSystemButton / ChromeSystemCloseButton 스타일은 App.xaml 로 이동
             (플로팅 카메라 창의 커스텀 타이틀바가 같은 스타일을 사용하기 위함). -->

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- TopBar 행 높이를 50 으로 확장. 이전 42 였을 때 테마 옵션 버튼 / Bridge 상태
                 라벨의 윗부분이 잘려 보이는 현상이 있었다 (콘텐츠 윗쪽이 Grid bounds 위로
                 튀어나가 Window 가 클립). WindowChrome.CaptionHeight=50 과도 자연스럽게 맞음. -->
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,6"
                Margin="0,0,0,8"
                Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource TopBarBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="VISION INSPECTOR WPF"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="18"
                           FontWeight="Bold" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Margin="20,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedText}"
                           Text="{Binding StatusMessage}" />
                <!-- 테마 선택: ItemsControl + 가로 Button 3개 → ComboBox 로 변경.
                     이전 가로 버튼 묶음은 TopBar 행 안에서 콘텐츠 윗부분이 잘리는 문제가
                     있었음. ComboBox 는 단일 라인이고 표준 ControlTemplate 이라 작은 행
                     높이에도 잘 맞춰진다. SelectedValue TwoWay 로 SelectedThemeKey 와
                     연결되어 setter 에서 SetSelectedTheme 가 호출되며 ThemeChanged 이벤트도
                     같이 발화. -->
                <ComboBox Grid.Column="2"
                          Margin="0,0,12,0"
                          MinWidth="130"
                          VerticalAlignment="Center"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedThemeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10"
                                        Height="10"
                                        CornerRadius="2"
                                        Background="{Binding SwatchBrush}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="BridgeStateText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{Binding BridgeStateBrush}"
                           FontWeight="Bold"
                           Text="{Binding BridgeState}" />

                <!--
                    Themed system buttons replacing the OS title bar's Min/Max/Close.
                    Each opts INTO hit-testing via WindowChrome.IsHitTestVisibleInChrome
                    so clicks reach them instead of starting a window drag.
                -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ChromeMinimizeButton"
                            Click="ChromeMinimizeButton_Click"
                            Style="{StaticResource ChromeSystemButton}"
                            ToolTip="Minimize"
                            Content="&#xE921;" />
                    <Button x:Name="ChromeMaximizeButton"
                            Click="ChromeMaximizeButton_Click"
                            Style="{StaticResource ChromeSystemButton}"
                            ToolTip="Maximize/Restore"
                            Content="&#xE922;" />
                    <Button x:Name="ChromeCloseButton"
                            Click="ChromeCloseButton_Click"
                            Style="{StaticResource ChromeSystemCloseButton}"
                            ToolTip="Close"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="500" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Cam01DockHost" Grid.Column="0">
                <Border x:Name="Cam01DockPlaceholder"
                        Style="{StaticResource PanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="CAM-01 FLOATING"
                                   Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="DOCK"
                                Tag="CAM01"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DockToolButton}"
                                Click="CameraDockButton_Click" />
                    </Grid>
                </Border>
                <Border x:Name="Cam01Panel" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Cursor="SizeAll"
                              Tag="CAM01"
                              PreviewMouseLeftButtonDown="CameraHeader_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CameraHeader_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CameraHeader_PreviewMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAM-01 | COLOR (R/G/B)" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="SourceInfoText"
                                       Grid.Column="1"
                                       Foreground="{Binding SourceInfoBrush}"
                                       FontWeight="Bold"
                                       Text="{Binding SourceInfoText}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="Cam01DockButton"
                                    Grid.Column="2"
                                    Content="FLOAT"
                                    Tag="CAM01"
                                    Style="{StaticResource DockToolButton}"
                                    Click="CameraDockButton_Click" />
                        </Grid>
                        <Grid Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
                            <Image x:Name="SourceImage"
                                   Source="{Binding Cam01ColorImage}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                        <TranslateTransform x:Name="SourceImagePanTransform" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Canvas x:Name="SourceOverlay"
                                    Background="Transparent"
                                    MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown"
                                    MouseMove="ImageOverlay_MouseMove"
                                    MouseLeftButtonUp="ImageOverlay_MouseLeftButtonUp"
                                    MouseWheel="ImageOverlay_MouseWheel"
                                    SizeChanged="Overlay_SizeChanged">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="SourceOverlayPanTransform" />
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <Grid x:Name="Cam02DockHost" Grid.Column="2">
                <Border x:Name="Cam02DockPlaceholder"
                        Style="{StaticResource PanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="CAM-02 FLOATING"
                                   Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="DOCK"
                                Tag="CAM02"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DockToolButton}"
                                Click="CameraDockButton_Click" />
                    </Grid>
                </Border>
                <Border x:Name="Cam02Panel" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Cursor="SizeAll"
                              Tag="CAM02"
                              PreviewMouseLeftButtonDown="CameraHeader_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CameraHeader_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CameraHeader_PreviewMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAM-02 | PTT DATA" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="PttInfoText"
                                       Grid.Column="1"
                                       Foreground="{Binding PttInfoBrush}"
                                       FontWeight="Bold"
                                       Text="{Binding PttInfoText}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="Cam02DockButton"
                                    Grid.Column="2"
                                    Content="FLOAT"
                                    Tag="CAM02"
                                    Style="{StaticResource DockToolButton}"
                                    Click="CameraDockButton_Click" />
                        </Grid>
                        <Grid x:Name="PttViewerSurface" Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
                            <TextBlock x:Name="PttEmptyText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DisabledText}"
                                       FontWeight="Bold"
                                       Visibility="{Binding PttEmptyVisibility}"
                                       Text="CAM-02 EMPTY" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />

            <Grid x:Name="Cam03DockHost" Grid.Column="4">
                <Border x:Name="Cam03DockPlaceholder"
                        Style="{StaticResource PanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="CAM-03 FLOATING"
                                   Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="DOCK"
                                Tag="CAM03"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DockToolButton}"
                                Click="CameraDockButton_Click" />
                    </Grid>
                </Border>
                <Border x:Name="Cam03Panel" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Cursor="SizeAll"
                              Tag="CAM03"
                              PreviewMouseLeftButtonDown="CameraHeader_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CameraHeader_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CameraHeader_PreviewMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Cam03Title}"
                                       Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="TimingText"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource AccentBlue}"
                                       FontWeight="Bold"
                                       Text="{Binding TimingText}"
                                       VerticalAlignment="Center" />
                            <!-- Cam03 보기 모드 토글: 라벨 = 전환 후 모드 (현재 Origin 이면 "Binary"). -->
                            <Button x:Name="Cam03ModeToggleButton"
                                    Grid.Column="2"
                                    Content="{Binding Cam03ToggleLabel}"
                                    Command="{Binding Cam03ToggleCommand}"
                                    Style="{StaticResource DockToolButton}"
                                    Margin="0,0,6,0"
                                    MinWidth="64" />
                            <Button x:Name="Cam03DockButton"
                                    Grid.Column="3"
                                    Content="FLOAT"
                                    Tag="CAM03"
                                    Style="{StaticResource DockToolButton}"
                                    Click="CameraDockButton_Click" />
                        </Grid>
                        <Grid Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
                            <Image x:Name="BinaryImage"
                                   Source="{Binding Cam03Image}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                        <TranslateTransform x:Name="BinaryImagePanTransform" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Canvas x:Name="BinaryOverlay"
                                    Background="Transparent"
                                    MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown"
                                    MouseMove="ImageOverlay_MouseMove"
                                    MouseLeftButtonUp="ImageOverlay_MouseLeftButtonUp"
                                    MouseWheel="ImageOverlay_MouseWheel"
                                    SizeChanged="Overlay_SizeChanged">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="BinaryOverlayPanTransform" />
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />

            <ScrollViewer Grid.Column="6" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RightPanelStack">
                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="MODEL" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Model Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ModelNameBox" Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <UniformGrid Columns="2">
                                <Button x:Name="SaveModelButton" Content="Save Model" Command="{Binding SaveModelCommand}" />
                                <Button x:Name="LoadModelButton" Content="Load Model" Command="{Binding LoadModelCommand}" />
                            </UniformGrid>
                            <Button x:Name="ImportPartButton"
                                    Content="Import Part"
                                    Margin="0,6,0,0"
                                    Command="{Binding ImportPartCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="IMAGE VIEWER" Style="{StaticResource PanelTitle}" />
                            <Button x:Name="LoadImageButton" Content="Load 2D Image" Command="{Binding LoadImageCommand}" />
                            <Button x:Name="LoadPttButton"
                                    Content="Load PTT Data"
                                    Margin="0,6,0,0"
                                    Command="{Binding LoadPttCommand}" />
                            <CheckBox x:Name="WheelZoomCheck"
                                      Content="Wheel Zoom"
                                      IsChecked="{Binding WheelZoomEnabled, Mode=TwoWay}"
                                      Checked="ViewerOption_Changed"
                                      Unchecked="ViewerOption_Changed" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zoom" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="ImageZoomSlider"
                                        Grid.Column="1"
                                        Minimum="1"
                                        Maximum="{Binding ImageZoomMaximum}"
                                        Value="{Binding ImageZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.1"
                                        ValueChanged="ImageZoomSlider_ValueChanged" />
                                <TextBlock x:Name="ImageZoomText"
                                           Grid.Column="2"
                                           Text="{Binding ImageZoomText}"
                                           Foreground="{DynamicResource AccentYellow}"
                                           FontWeight="Bold"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="Zoom 1x" Command="{Binding ZoomOneCommand}" />
                                <Button Content="Zoom Fit" Command="{Binding ZoomFitCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <!--
                              인스펙션 트리 툴바.
                              + : 모든 노드 펼치기
                              - : 모든 노드 접기
                              Window List ComboBox : Window TypeName 필터 ("All" 또는 특정 타입)
                              ▼ / ▲ : 선택된 Window 한 칸 아래/위로 이동
                              ▼▼ / ▲▲ : 맨 아래/위로 이동
                              모든 색상은 DynamicResource 로 테마 따름.
                            -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="+"
                                        ToolTip="Expand all nodes"
                                        Command="{Binding ExpandAllTreeNodesCommand}"
                                        Width="28" Height="26" MinHeight="26"
                                        Margin="0,0,4,0" Padding="0"
                                        FontWeight="Bold" FontSize="14"
                                        Foreground="#FFFFFF"
                                        Background="{DynamicResource AccentBlue}"
                                        BorderBrush="{DynamicResource AccentBlue}" />
                                <Button Grid.Column="1"
                                        Content="-"
                                        ToolTip="Collapse all nodes"
                                        Command="{Binding CollapseAllTreeNodesCommand}"
                                        Width="28" Height="26" MinHeight="26"
                                        Margin="0" Padding="0"
                                        FontWeight="Bold" FontSize="14"
                                        Foreground="#1A0F00"
                                        Background="{DynamicResource AccentYellow}"
                                        BorderBrush="{DynamicResource AccentYellow}" />

                                <TextBlock Grid.Column="3"
                                           Text="Window List"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontWeight="SemiBold" />
                                <ComboBox Grid.Column="4"
                                          Height="26" MinHeight="26"
                                          ItemsSource="{Binding WindowTypeFilters}"
                                          SelectedItem="{Binding SelectedWindowTypeFilter, Mode=TwoWay}"
                                          FontWeight="SemiBold" />

                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <!--
                                      Move-Window 버튼들. 색상 하드코딩 제거 - 전역 Button 기본
                                      스타일 (ControlBackground / ControlBorder / PrimaryText, 모두
                                      DynamicResource) 에 위임. 테마 (Dark/Light/Pink) 가 바뀌면
                                      자동으로 색이 따라감.
                                      AccentBlue / Foreground=White 같은 직접 색은 사용 안 함.
                                    -->
                                    <Button Content="&#x25BC;"
                                            ToolTip="Move selected Window down"
                                            Command="{Binding MoveSelectedWindowDownCommand}"
                                            Width="26" Height="26" MinHeight="26"
                                            Margin="0,0,2,0" Padding="0"
                                            FontSize="10" />
                                    <Button Content="&#x25B2;"
                                            ToolTip="Move selected Window up"
                                            Command="{Binding MoveSelectedWindowUpCommand}"
                                            Width="26" Height="26" MinHeight="26"
                                            Margin="0,0,6,0" Padding="0"
                                            FontSize="10" />
                                    <!--
                                      U+23EC / U+23EB 는 ▼ / ▲ 의 더블 트라이앵글 버전 -
                                      single arrow 와 시각적 일관성이 있고 "맨 끝으로 이동"
                                      의미가 자연스럽게 전달됨. 이전 ⇩ / ⇧ (U+21E9/E7) 의
                                      이중-막대 스타일은 모양이 어색해서 교체.
                                    -->
                                    <Button Content="&#x23EC;"
                                            ToolTip="Move selected Window to bottom"
                                            Command="{Binding MoveSelectedWindowToBottomCommand}"
                                            Width="26" Height="26" MinHeight="26"
                                            Margin="0,0,2,0" Padding="0"
                                            FontSize="10" />
                                    <Button Content="&#x23EB;"
                                            ToolTip="Move selected Window to top"
                                            Command="{Binding MoveSelectedWindowToTopCommand}"
                                            Width="26" Height="26" MinHeight="26"
                                            Margin="0" Padding="0"
                                            FontSize="10" />
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,0,0,8"
                                    MinHeight="190"
                                    MaxHeight="280"
                                    Background="{DynamicResource ComboDarkBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}"
                                    BorderThickness="1"
                                    Grid.IsSharedSizeScope="True">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top"
                                          Height="24"
                                          Background="{DynamicResource TreeHeaderBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="96" MinWidth="72" SharedSizeGroup="WindowListName" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="76" MinWidth="58" SharedSizeGroup="WindowListType" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEnb" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEss" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListGrp" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="46" MinWidth="42" SharedSizeGroup="WindowListGrpId" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="12" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,0,1" />
                                        <TextBlock Grid.Column="1" Text="Name" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="3" Text="Type" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="Enb" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="Ess" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="9" Text="Grp" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="11" Text="GrpID" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <GridSplitter Grid.Column="2" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="4" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="6" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="8" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="10" Style="{StaticResource TreeHeaderSplitter}" />
                                    </Grid>
                                    <TreeView x:Name="InspectionTree"
                                              ItemsSource="{Binding InspectionTreeNodes}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ComboDarkBackground}"
                                              BorderThickness="0"
                                              Foreground="{DynamicResource PrimaryText}"
                                              SelectedItemChanged="InspectionTree_SelectedItemChanged" />
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="SelectedWindowText"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedWindowText}" />
                        </StackPanel>
                    </Border>

                    <!-- ALGORITHM TYPE panel 제거됨 (ComboBox + Selected text).
                         사용자 요청에 따라 UI 만 삭제. ViewModel 의 SelectedAlgorithm
                         속성은 유지 — 인스펙션 트리/AlignPanel 등 다른 경로에서
                         여전히 사용됨. -->

                    <views:LightControlView DataContext="{Binding LightControl}" />

                    <ContentControl x:Name="AlgorithmPanelHost" Content="{Binding ActiveAlgorithmPanelContent}" />

                    <Grid x:Name="AlgorithmPanelStaging" Visibility="Collapsed">
                    <views:AlignPanelView x:Name="AlignPanel" />
                     <Border x:Name="GenericAlgorithmPanel" Style="{StaticResource RightPanelBorder}" Visibility="Collapsed">
                         <StackPanel>
                             <TextBlock Text="PARAMETER" Style="{StaticResource PanelTitle}" />
                             <TextBlock Text="Selected algorithm uses the shared prototype threshold preview. Algorithm metadata is saved with the Window child item."
                                        Foreground="{DynamicResource MutedText}"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,8" />
                            <Button x:Name="DrawGenericAlgorithmRoiButton"
                                    Content="Draw Algorithm ROI"
                                    Command="{Binding DrawAlgorithmRoiCommand}" />
                         </StackPanel>
                     </Border>
                    </Grid>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="INSPECTION RESULT" Style="{StaticResource PanelTitle}" />
                            <Button x:Name="RunInspectButton"
                                    Content="Run Part Inspection"
                                    Command="{Binding RunInspectionCommand}"
                                    IsEnabled="{Binding CanRunInspection}" />
                            <Button x:Name="RunFlowButton"
                                    Margin="0,4,0,0"
                                    Content="Run MPTI Flow (Align)"
                                    Command="{Binding RunFlowCommand}" />
                            <TextBox x:Name="ResultText"
                                     Margin="0,8,0,0"
                                     Height="130"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Text="{Binding InspectionResultText}" />

                            <!-- MPTI FLOW ALGORITHMS ItemsControl 제거됨 (사용자 요청).
                                 FlowAlgorithmRunner / IFlowAlgorithm 인프라 및
                                 MainViewModel.FlowAlgorithms 컬렉션은 코드상에 유지
                                 (콘솔 harness / 향후 재노출용). -->
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            Part Import 진행 중 화면 위에 띄우는 modal 오버레이. 외곽은 반투명 검정으로
            기존 UI 를 dim 시켜서 입력을 차단(IsHitTestVisible 자동)하고, 중앙 Border
            안에 indeterminate ProgressBar 와 단계 텍스트를 표시한다. MainViewModel 의
            IsImporting / ImportProgressText 가 변경되면 자동으로 보이고 사라진다.
        -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#88000000"
              Visibility="{Binding ImportOverlayVisibility}">
            <Border Width="420"
                    Padding="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource AccentBlue}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="IMPORTING PART"
                               Foreground="{DynamicResource AccentBlue}"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,12" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ImportProgressText}"
                               Foreground="{DynamicResource PrimaryText}"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
