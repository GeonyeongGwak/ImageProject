<Window x:Class="WpfInspectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfInspectionApp.ViewModels"
        xmlns:views="clr-namespace:WpfInspectionApp.Views"
        xmlns:fa="clr-namespace:WpfInspectionApp.Services.FlowAlgorithms"
        Title="WPF Vision Inspector Prototype"
        Width="1680"
        Height="980"
        MinWidth="1180"
        MinHeight="720"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#070B12">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#0B1320" />
        <SolidColorBrush x:Key="BorderBlue" Color="#155FA4" />
        <SolidColorBrush x:Key="AccentBlue" Color="#27A6FF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#18E07B" />
        <SolidColorBrush x:Key="AccentYellow" Color="#FFB020" />
        <SolidColorBrush x:Key="ComboDarkBackground" Color="#07101C" />
        <SolidColorBrush x:Key="ComboDarkHover" Color="#10243D" />
        <SolidColorBrush x:Key="ComboDarkSelected" Color="#0E5EA8" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#07101C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E4F3FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E5EA8" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#E4F3FF" />
            <Setter Property="Background" Value="#10243D" />
            <Setter Property="BorderBrush" Value="#236EA8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="#E4F3FF" />
            <Setter Property="Background" Value="#07101C" />
            <Setter Property="BorderBrush" Value="#284A72" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#E4F3FF" />
            <Setter Property="Background" Value="{StaticResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="#284A72" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" />
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="#E4F3FF"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="8,2,34,2"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="6,2,34,2"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Visibility="Hidden"
                                     Foreground="#E4F3FF"
                                     Background="{StaticResource ComboDarkBackground}"
                                     BorderThickness="0"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource ComboDarkBackground}"
                                        BorderBrush="#236EA8"
                                        BorderThickness="1">
                                    <ScrollViewer Margin="0"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="{StaticResource ComboDarkHover}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="#0B1D33" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#63748A" />
                                <Setter TargetName="ToggleButton" Property="Background" Value="#050A12" />
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#1B2D44" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="#E4F3FF" />
            <Setter Property="Background" Value="{StaticResource ComboDarkBackground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ComboDarkHover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ComboDarkSelected}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#63748A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6E8FF" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#234466" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DDEEFF" />
            <Setter Property="Background" Value="#0D2038" />
            <Setter Property="BorderBrush" Value="#236EA8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TreeExpandToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#DDEEFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#284A72" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Content" Value="+" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="GlyphBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlyphBorder" Property="Background" Value="#10243D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GlyphBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="-" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Border x:Name="HeaderBorder"
                                    Grid.ColumnSpan="2"
                                    Background="Transparent"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource TreeExpandToggleButton}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="Hidden" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#123A5C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#63748A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:InspectionTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Header}"
                       Foreground="{Binding Foreground, TargetNullValue=#EAF6FF, FallbackValue=#EAF6FF}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="RightPanelBorder" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#10243D" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DB4D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,6"
                Margin="0,0,0,8"
                Background="#111827"
                BorderBrush="#1F70B8"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="VISION INSPECTOR WPF"
                           VerticalAlignment="Center"
                           Foreground="#E7F4FF"
                           FontSize="18"
                           FontWeight="Bold" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Margin="20,0"
                           VerticalAlignment="Center"
                           Foreground="#91A9C7"
                           Text="{Binding StatusMessage}" />
                <TextBlock x:Name="BridgeStateText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{Binding BridgeStateBrush}"
                           FontWeight="Bold"
                           Text="{Binding BridgeState}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="390" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CAM-01 | 2D SOURCE" Style="{StaticResource PanelTitle}" />
                        <TextBlock x:Name="SourceInfoText"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding SourceInfoBrush}"
                                   FontWeight="Bold"
                                   Text="{Binding SourceInfoText}" />
                    </Grid>
                    <Grid Background="#02050A" ClipToBounds="True">
                        <Image x:Name="SourceImage"
                               Source="{Binding SourceImage}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                            </Image.RenderTransform>
                        </Image>
                        <Canvas x:Name="SourceOverlay"
                                Background="Transparent"
                                MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown"
                                MouseMove="ImageOverlay_MouseMove"
                                MouseLeftButtonUp="ImageOverlay_MouseLeftButtonUp"
                                MouseWheel="ImageOverlay_MouseWheel"
                                SizeChanged="Overlay_SizeChanged" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CAM-02 | 3D SOURCE" Style="{StaticResource PanelTitle}" />
                        <TextBlock x:Name="PttInfoText"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding PttInfoBrush}"
                                   FontWeight="Bold"
                                   Text="{Binding PttInfoText}" />
                    </Grid>
                    <Grid x:Name="PttViewerSurface" Background="#02050A" ClipToBounds="True">
                        <TextBlock x:Name="PttEmptyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#5F7898"
                                   FontWeight="Bold"
                                   Visibility="{Binding PttEmptyVisibility}"
                                   Text="CAM-02 EMPTY" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CAM-03 | BINARY RESULT" Style="{StaticResource PanelTitle}" />
                        <TextBlock x:Name="TimingText"
                                   HorizontalAlignment="Right"
                                   Foreground="#80DFFF"
                                   FontWeight="Bold"
                                   Text="{Binding TimingText}" />
                    </Grid>
                    <Grid Background="#02050A" ClipToBounds="True">
                        <Image x:Name="BinaryImage"
                               Source="{Binding BinaryImage}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                            </Image.RenderTransform>
                        </Image>
                        <Canvas x:Name="BinaryOverlay"
                                Background="Transparent"
                                MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown"
                                MouseMove="ImageOverlay_MouseMove"
                                MouseLeftButtonUp="ImageOverlay_MouseLeftButtonUp"
                                MouseWheel="ImageOverlay_MouseWheel"
                                SizeChanged="Overlay_SizeChanged" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />

            <ScrollViewer Grid.Column="6" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RightPanelStack">
                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="MODEL" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Model Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ModelNameBox" Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <UniformGrid Columns="2">
                                <Button x:Name="SaveModelButton" Content="Save Model" Command="{Binding SaveModelCommand}" />
                                <Button x:Name="LoadModelButton" Content="Load Model" Command="{Binding LoadModelCommand}" />
                            </UniformGrid>
                            <Button x:Name="ImportPartButton"
                                    Content="Import Part"
                                    Margin="0,6,0,0"
                                    Command="{Binding ImportPartCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="IMAGE VIEWER" Style="{StaticResource PanelTitle}" />
                            <Button x:Name="LoadImageButton" Content="Load 2D Image" Command="{Binding LoadImageCommand}" />
                            <Button x:Name="LoadPttButton"
                                    Content="Load 3D PTT"
                                    Margin="0,6,0,0"
                                    Command="{Binding LoadPttCommand}" />
                            <CheckBox x:Name="WheelZoomCheck"
                                      Content="Wheel Zoom"
                                      IsChecked="{Binding WheelZoomEnabled, Mode=TwoWay}"
                                      Checked="ViewerOption_Changed"
                                      Unchecked="ViewerOption_Changed" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zoom" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="ImageZoomSlider"
                                        Grid.Column="1"
                                        Minimum="1"
                                        Maximum="{Binding ImageZoomMaximum}"
                                        Value="{Binding ImageZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.1"
                                        ValueChanged="ImageZoomSlider_ValueChanged" />
                                <TextBlock x:Name="ImageZoomText"
                                           Grid.Column="2"
                                           Text="{Binding ImageZoomText}"
                                           Foreground="#FFB020"
                                           FontWeight="Bold"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="Zoom 1x" Command="{Binding ZoomOneCommand}" />
                                <Button Content="Zoom Fit" Command="{Binding ZoomFitCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock x:Name="PartTreeTitle" Text="{Binding PartTitle}" Style="{StaticResource PanelTitle}" />
                            <TreeView x:Name="InspectionTree"
                                      MinHeight="190"
                                      MaxHeight="280"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding InspectionTreeNodes}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      Background="#07101C"
                                      BorderBrush="#284A72"
                                      Foreground="#E4F3FF"
                                      SelectedItemChanged="InspectionTree_SelectedItemChanged" />
                            <TextBlock x:Name="SelectedWindowText"
                                       Margin="0,0,0,8"
                                       Foreground="#D6ECFF"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedWindowText}" />
                            <Button x:Name="AddAlgorithmButton"
                                    Content="Algorithm Add"
                                    Command="{Binding AddAlgorithmCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="ALGORITHM TYPE" Style="{StaticResource PanelTitle}" />
                            <ComboBox x:Name="AlgorithmCombo"
                                      MinHeight="34"
                                      Height="34"
                                      FontSize="13"
                                      Foreground="#FFFFFF"
                                      Background="#0B5CAD"
                                      ItemsSource="{Binding AlgorithmTypes}"
                                      SelectedItem="{Binding SelectedAlgorithm, Mode=TwoWay}"
                                      SelectionChanged="AlgorithmCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#E4F3FF"
                                                   FontWeight="Bold"
                                                   Padding="4,2" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,6,0,0"
                                       Padding="10,6"
                                       Foreground="#FFFFFF"
                                       Background="#0B5CAD"
                                       FontSize="14"
                                       FontWeight="ExtraBold"
                                       Text="{Binding SelectedAlgorithmText}" />
                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="AlgorithmPanelHost" Content="{Binding ActiveAlgorithmPanelContent}" />

                    <Grid x:Name="AlgorithmPanelStaging" Visibility="Collapsed">
                    <views:AlignPanelView x:Name="AlignPanel" />
                     <Border x:Name="GenericAlgorithmPanel" Style="{StaticResource RightPanelBorder}" Visibility="Collapsed">
                         <StackPanel>
                             <TextBlock Text="PARAMETER" Style="{StaticResource PanelTitle}" />
                             <TextBlock Text="Selected algorithm uses the shared prototype threshold preview. Algorithm metadata is saved with the Window child item."
                                        Foreground="#8BA5C4"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,8" />
                            <Button x:Name="DrawGenericAlgorithmRoiButton"
                                    Content="Draw Algorithm ROI"
                                    Click="DrawAlgorithmRoiButton_Click" />
                         </StackPanel>
                     </Border>
                    </Grid>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="INSPECTION RESULT" Style="{StaticResource PanelTitle}" />
                            <Button x:Name="RunInspectButton"
                                    Content="Run Part Inspection"
                                    Command="{Binding RunInspectionCommand}"
                                    IsEnabled="{Binding CanRunInspection}" />
                            <Button x:Name="RunFlowButton"
                                    Margin="0,4,0,0"
                                    Content="Run MPTI Flow (Align - legacy)"
                                    Command="{Binding RunFlowCommand}" />
                            <TextBox x:Name="ResultText"
                                     Margin="0,8,0,0"
                                     Height="130"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Text="{Binding InspectionResultText}" />

                            <TextBlock Text="MPTI FLOW ALGORITHMS" Style="{StaticResource PanelTitle}" Margin="0,12,0,0" />
                            <!-- Auto-renders one row per registered IFlowAlgorithm.
                                 Adding a new algorithm in AppServices grows this list
                                 without touching MainViewModel or XAML. -->
                            <ItemsControl ItemsSource="{Binding FlowAlgorithms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One row per registered algorithm. The Expander
                                             header has the Run button + summary; expanded
                                             content is an implicit DataTemplate matched
                                             on the Parameters' concrete type (defined in
                                             Views/FlowAlgorithmTemplates.xaml). -->
                                        <!--
                                          Each row is a header (color chip + Run + Summary + toggle) and a
                                          collapsible body. We avoid WPF Expander on purpose - its built-in
                                          chevron RotateTransform calls Matrix.CreateRotationRadians during
                                          the first layout pass which triggers an FP-inexact SEH under VS
                                          native debugging and crashes the process (0xC0000005 in JIT code).
                                          A plain ToggleButton + Visibility binding doesn't go through
                                          any rotation/animation path.
                                        -->
                                        <StackPanel Margin="0,2,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <!-- OK/NG color chip: bound directly to a Brush computed
                                                     on the runner. No DataTrigger / IValueConverter
                                                     evaluation on the layout-critical path. -->
                                                <Border Grid.Column="0"
                                                        Width="10" Height="10"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding OkNgBrush}" />
                                                <Button Grid.Column="1"
                                                        Content="{Binding DisplayName}"
                                                        Command="{Binding RunCommand}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Summary}"
                                                           Text="{Binding Summary}" />
                                                <!-- Two-state toggle (+ / -). No RotateTransform / Storyboard. -->
                                                <ToggleButton Grid.Column="3"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              FontFamily="Consolas">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Content" Value="+" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Content" Value="-" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- Collapsible body. Visibility binding uses WPF's built-in
                                                 BooleanToVisibilityConverter (no custom converter call). -->
                                            <StackPanel Margin="20,4,0,8"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ContentPresenter Content="{Binding Parameters}" />

                                                <TextBlock Text="LAST RESULT FIELDS"
                                                           Margin="0,10,0,2"
                                                           FontSize="10"
                                                           Foreground="#8BA5C4" />

                                                <ItemsControl ItemsSource="{Binding LastResult.Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Key}"
                                                                           Foreground="#8BA5C4" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           FontFamily="Consolas"
                                                                           Foreground="#E0E8F0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
