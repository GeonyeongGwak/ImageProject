<Window x:Class="WpfInspectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfInspectionApp.ViewModels"
        xmlns:views="clr-namespace:WpfInspectionApp.Views"
        xmlns:fa="clr-namespace:WpfInspectionApp.Services.FlowAlgorithms"
        Title="WPF Vision Inspector Prototype"
        Width="1680"
        Height="980"
        MinWidth="1180"
        MinHeight="720"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#070B12" />
        <SolidColorBrush x:Key="TopBarBackground" Color="#111827" />
        <SolidColorBrush x:Key="TopBarBorder" Color="#1F70B8" />
        <SolidColorBrush x:Key="PrimaryText" Color="#E4F3FF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#D6ECFF" />
        <SolidColorBrush x:Key="MutedText" Color="#8BA5C4" />
        <SolidColorBrush x:Key="DisabledText" Color="#63748A" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#02050A" />
        <SolidColorBrush x:Key="ControlBackground" Color="#10243D" />
        <SolidColorBrush x:Key="ControlHover" Color="#10243D" />
        <SolidColorBrush x:Key="ControlBorder" Color="#236EA8" />
        <SolidColorBrush x:Key="TreeHeaderBackground" Color="#0D2038" />
        <SolidColorBrush x:Key="TreeSelectedBackground" Color="#123A5C" />
        <SolidColorBrush x:Key="PanelBackground" Color="#0B1320" />
        <SolidColorBrush x:Key="BorderBlue" Color="#155FA4" />
        <SolidColorBrush x:Key="AccentBlue" Color="#27A6FF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#18E07B" />
        <SolidColorBrush x:Key="AccentYellow" Color="#FFB020" />
        <SolidColorBrush x:Key="ComboDarkBackground" Color="#07101C" />
        <SolidColorBrush x:Key="ComboDarkHover" Color="#10243D" />
        <SolidColorBrush x:Key="ComboDarkSelected" Color="#0E5EA8" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#07101C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E4F3FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E5EA8" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" />
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource PrimaryText}"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="8,2,34,2"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="6,2,34,2"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Visibility="Hidden"
                                     Foreground="{DynamicResource PrimaryText}"
                                     Background="{DynamicResource ComboDarkBackground}"
                                     BorderThickness="0"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ComboDarkBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}"
                                        BorderThickness="1">
                                    <ScrollViewer Margin="0"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource ComboDarkHover}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                                <Setter TargetName="ToggleButton" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboDarkHover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboDarkSelected}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TreeGridCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TreeGridNameEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeAlgorithmContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxHeight" Value="460" />
        </Style>

        <Style x:Key="TreeAlgorithmMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource ComboDarkBackground}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid MinWidth="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18"
                                    Height="18"
                                    Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource BorderBlue}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path Data="{Binding IconGeometry}"
                                      Stroke="{Binding IconBrush}"
                                      Fill="Transparent"
                                      StrokeThickness="1.45"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Margin="3" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="{DynamicResource TreeHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TreeExpandToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Content" Value="+" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="GlyphBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlyphBorder" Property="Background" Value="{DynamicResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GlyphBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="-" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="InspectionTreeItem_PreviewMouseRightButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Border x:Name="HeaderBorder"
                                    Grid.ColumnSpan="2"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    ContextMenuService.IsEnabled="{Binding HasAlgorithmMenu}">
                                <Border.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.AlgorithmMenuItems, RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource TreeAlgorithmContextMenu}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource TreeAlgorithmMenuItem}" />
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource TreeExpandToggleButton}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="Hidden" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TreeSelectedBackground}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:InspectionTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <Grid Height="23"
                  MinWidth="350"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" MinWidth="72" SharedSizeGroup="WindowListName" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="76" MinWidth="58" SharedSizeGroup="WindowListType" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEnb" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEss" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListGrp" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="46" MinWidth="42" SharedSizeGroup="WindowListGrpId" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="{Binding NamePadding}">
                    <TextBox Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource TreeGridNameEditor}"
                             Visibility="{Binding NameEditorVisibility}">
                        <TextBox.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.AlgorithmMenuItems, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource TreeAlgorithmContextMenu}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource TreeAlgorithmMenuItem}" />
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                    <TextBlock Text="{Binding NameText}"
                               Foreground="{Binding Foreground, TargetNullValue=#EAF6FF, FallbackValue=#EAF6FF}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding NameDisplayVisibility}" />
                </Grid>
                <TextBlock Grid.Column="2"
                           Text="{Binding TypeText}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding GridCellVisibility}" />
                <CheckBox Grid.Column="4"
                          Style="{StaticResource TreeGridCheckBox}"
                          IsChecked="{Binding IsInspectionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding GridCellVisibility}" />
                <CheckBox Grid.Column="6"
                          Style="{StaticResource TreeGridCheckBox}"
                          IsChecked="{Binding IsEssential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding GridCellVisibility}" />
                <CheckBox Grid.Column="8"
                          Style="{StaticResource TreeGridCheckBox}"
                          IsEnabled="{Binding CanEditGroup}"
                          IsChecked="{Binding IsGrouped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding GridCellVisibility}" />
                <TextBlock Grid.Column="10"
                           Text="{Binding GroupId}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="12"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding GroupIdVisibility}" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="RightPanelBorder" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="TreeHeaderSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DockToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="52" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource TreeHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        </Style>

        <Style x:Key="ThemeOptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,6"
                Margin="0,0,0,8"
                Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource TopBarBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="VISION INSPECTOR WPF"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="18"
                           FontWeight="Bold" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Margin="20,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedText}"
                           Text="{Binding StatusMessage}" />
                <ItemsControl Grid.Column="2"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding ThemeOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}"
                                    Background="{Binding ButtonBackground}"
                                    BorderBrush="{Binding ButtonBorderBrush}"
                                    Style="{StaticResource ThemeOptionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="2"
                                            Background="{Binding SwatchBrush}"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource PrimaryText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="BridgeStateText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{Binding BridgeStateBrush}"
                           FontWeight="Bold"
                           Text="{Binding BridgeState}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="390" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Cam01DockHost" Grid.Column="0">
                <Border x:Name="Cam01DockPlaceholder"
                        Style="{StaticResource PanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="CAM-01 FLOATING"
                                   Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="DOCK"
                                Tag="CAM01"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DockToolButton}"
                                Click="CameraDockButton_Click" />
                    </Grid>
                </Border>
                <Border x:Name="Cam01Panel" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Cursor="SizeAll"
                              Tag="CAM01"
                              PreviewMouseLeftButtonDown="CameraHeader_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CameraHeader_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CameraHeader_PreviewMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAM-01 | 2D SOURCE" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="SourceInfoText"
                                       Grid.Column="1"
                                       Foreground="{Binding SourceInfoBrush}"
                                       FontWeight="Bold"
                                       Text="{Binding SourceInfoText}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="Cam01DockButton"
                                    Grid.Column="2"
                                    Content="FLOAT"
                                    Tag="CAM01"
                                    Style="{StaticResource DockToolButton}"
                                    Click="CameraDockButton_Click" />
                        </Grid>
                        <Grid Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
                            <Image x:Name="SourceImage"
                                   Source="{Binding SourceImage}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                        <TranslateTransform x:Name="SourceImagePanTransform" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Canvas x:Name="SourceOverlay"
                                    Background="Transparent"
                                    MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown"
                                    MouseMove="ImageOverlay_MouseMove"
                                    MouseLeftButtonUp="ImageOverlay_MouseLeftButtonUp"
                                    MouseWheel="ImageOverlay_MouseWheel"
                                    SizeChanged="Overlay_SizeChanged">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="SourceOverlayPanTransform" />
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <Grid x:Name="Cam02DockHost" Grid.Column="2">
                <Border x:Name="Cam02DockPlaceholder"
                        Style="{StaticResource PanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="CAM-02 FLOATING"
                                   Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="DOCK"
                                Tag="CAM02"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DockToolButton}"
                                Click="CameraDockButton_Click" />
                    </Grid>
                </Border>
                <Border x:Name="Cam02Panel" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Cursor="SizeAll"
                              Tag="CAM02"
                              PreviewMouseLeftButtonDown="CameraHeader_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CameraHeader_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CameraHeader_PreviewMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAM-02 | 3D SOURCE" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="PttInfoText"
                                       Grid.Column="1"
                                       Foreground="{Binding PttInfoBrush}"
                                       FontWeight="Bold"
                                       Text="{Binding PttInfoText}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="Cam02DockButton"
                                    Grid.Column="2"
                                    Content="FLOAT"
                                    Tag="CAM02"
                                    Style="{StaticResource DockToolButton}"
                                    Click="CameraDockButton_Click" />
                        </Grid>
                        <Grid x:Name="PttViewerSurface" Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
                            <TextBlock x:Name="PttEmptyText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DisabledText}"
                                       FontWeight="Bold"
                                       Visibility="{Binding PttEmptyVisibility}"
                                       Text="CAM-02 EMPTY" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />

            <Grid x:Name="Cam03DockHost" Grid.Column="4">
                <Border x:Name="Cam03DockPlaceholder"
                        Style="{StaticResource PanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="CAM-03 FLOATING"
                                   Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="DOCK"
                                Tag="CAM03"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DockToolButton}"
                                Click="CameraDockButton_Click" />
                    </Grid>
                </Border>
                <Border x:Name="Cam03Panel" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Cursor="SizeAll"
                              Tag="CAM03"
                              PreviewMouseLeftButtonDown="CameraHeader_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="CameraHeader_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="CameraHeader_PreviewMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAM-03 | BINARY RESULT" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="TimingText"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource AccentBlue}"
                                       FontWeight="Bold"
                                       Text="{Binding TimingText}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="Cam03DockButton"
                                    Grid.Column="2"
                                    Content="FLOAT"
                                    Tag="CAM03"
                                    Style="{StaticResource DockToolButton}"
                                    Click="CameraDockButton_Click" />
                        </Grid>
                        <Grid Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
                            <Image x:Name="BinaryImage"
                                   Source="{Binding BinaryImage}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                        <TranslateTransform x:Name="BinaryImagePanTransform" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Canvas x:Name="BinaryOverlay"
                                    Background="Transparent"
                                    MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown"
                                    MouseMove="ImageOverlay_MouseMove"
                                    MouseLeftButtonUp="ImageOverlay_MouseLeftButtonUp"
                                    MouseWheel="ImageOverlay_MouseWheel"
                                    SizeChanged="Overlay_SizeChanged">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="BinaryOverlayPanTransform" />
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />

            <ScrollViewer Grid.Column="6" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RightPanelStack">
                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="MODEL" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Model Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ModelNameBox" Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <UniformGrid Columns="2">
                                <Button x:Name="SaveModelButton" Content="Save Model" Command="{Binding SaveModelCommand}" />
                                <Button x:Name="LoadModelButton" Content="Load Model" Command="{Binding LoadModelCommand}" />
                            </UniformGrid>
                            <Button x:Name="ImportPartButton"
                                    Content="Import Part"
                                    Margin="0,6,0,0"
                                    Command="{Binding ImportPartCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="IMAGE VIEWER" Style="{StaticResource PanelTitle}" />
                            <Button x:Name="LoadImageButton" Content="Load 2D Image" Command="{Binding LoadImageCommand}" />
                            <Button x:Name="LoadPttButton"
                                    Content="Load 3D PTT"
                                    Margin="0,6,0,0"
                                    Command="{Binding LoadPttCommand}" />
                            <CheckBox x:Name="WheelZoomCheck"
                                      Content="Wheel Zoom"
                                      IsChecked="{Binding WheelZoomEnabled, Mode=TwoWay}"
                                      Checked="ViewerOption_Changed"
                                      Unchecked="ViewerOption_Changed" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zoom" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="ImageZoomSlider"
                                        Grid.Column="1"
                                        Minimum="1"
                                        Maximum="{Binding ImageZoomMaximum}"
                                        Value="{Binding ImageZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.1"
                                        ValueChanged="ImageZoomSlider_ValueChanged" />
                                <TextBlock x:Name="ImageZoomText"
                                           Grid.Column="2"
                                           Text="{Binding ImageZoomText}"
                                           Foreground="{DynamicResource AccentYellow}"
                                           FontWeight="Bold"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="Zoom 1x" Command="{Binding ZoomOneCommand}" />
                                <Button Content="Zoom Fit" Command="{Binding ZoomFitCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock x:Name="PartTreeTitle" Text="{Binding PartTitle}" Style="{StaticResource PanelTitle}" />
                            <Border Margin="0,0,0,8"
                                    MinHeight="190"
                                    MaxHeight="280"
                                    Background="{DynamicResource ComboDarkBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}"
                                    BorderThickness="1"
                                    Grid.IsSharedSizeScope="True">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top"
                                          Height="24"
                                          Background="{DynamicResource TreeHeaderBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="96" MinWidth="72" SharedSizeGroup="WindowListName" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="76" MinWidth="58" SharedSizeGroup="WindowListType" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEnb" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListEss" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="34" MinWidth="32" SharedSizeGroup="WindowListGrp" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="46" MinWidth="42" SharedSizeGroup="WindowListGrpId" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="12" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,0,1" />
                                        <TextBlock Grid.Column="1" Text="Name" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="3" Text="Type" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="Enb" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="Ess" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="9" Text="Grp" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="11" Text="GrpID" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                                        <GridSplitter Grid.Column="2" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="4" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="6" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="8" Style="{StaticResource TreeHeaderSplitter}" />
                                        <GridSplitter Grid.Column="10" Style="{StaticResource TreeHeaderSplitter}" />
                                    </Grid>
                                    <TreeView x:Name="InspectionTree"
                                              ItemsSource="{Binding InspectionTreeNodes}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ComboDarkBackground}"
                                              BorderThickness="0"
                                              Foreground="{DynamicResource PrimaryText}"
                                              SelectedItemChanged="InspectionTree_SelectedItemChanged" />
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="SelectedWindowText"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedWindowText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="ALGORITHM TYPE" Style="{StaticResource PanelTitle}" />
                            <ComboBox x:Name="AlgorithmCombo"
                                      MinHeight="34"
                                      Height="34"
                                      FontSize="13"
                                      Foreground="{DynamicResource PrimaryText}"
                                      Background="{DynamicResource ComboDarkSelected}"
                                      ItemsSource="{Binding AlgorithmTypes}"
                                      SelectedItem="{Binding SelectedAlgorithm, Mode=TwoWay}"
                                      SelectionChanged="AlgorithmCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   FontWeight="Bold"
                                                   Padding="4,2" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,6,0,0"
                                       Padding="10,6"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Background="{DynamicResource ComboDarkSelected}"
                                       FontSize="14"
                                       FontWeight="ExtraBold"
                                       Text="{Binding SelectedAlgorithmText}" />
                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="AlgorithmPanelHost" Content="{Binding ActiveAlgorithmPanelContent}" />

                    <Grid x:Name="AlgorithmPanelStaging" Visibility="Collapsed">
                    <views:AlignPanelView x:Name="AlignPanel" />
                     <Border x:Name="GenericAlgorithmPanel" Style="{StaticResource RightPanelBorder}" Visibility="Collapsed">
                         <StackPanel>
                             <TextBlock Text="PARAMETER" Style="{StaticResource PanelTitle}" />
                             <TextBlock Text="Selected algorithm uses the shared prototype threshold preview. Algorithm metadata is saved with the Window child item."
                                        Foreground="{DynamicResource MutedText}"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,8" />
                            <Button x:Name="DrawGenericAlgorithmRoiButton"
                                    Content="Draw Algorithm ROI"
                                    Click="DrawAlgorithmRoiButton_Click" />
                         </StackPanel>
                     </Border>
                    </Grid>

                    <Border Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="INSPECTION RESULT" Style="{StaticResource PanelTitle}" />
                            <Button x:Name="RunInspectButton"
                                    Content="Run Part Inspection"
                                    Command="{Binding RunInspectionCommand}"
                                    IsEnabled="{Binding CanRunInspection}" />
                            <Button x:Name="RunFlowButton"
                                    Margin="0,4,0,0"
                                    Content="Run MPTI Flow (Align - legacy)"
                                    Command="{Binding RunFlowCommand}" />
                            <TextBox x:Name="ResultText"
                                     Margin="0,8,0,0"
                                     Height="130"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Text="{Binding InspectionResultText}" />

                            <TextBlock Text="MPTI FLOW ALGORITHMS" Style="{StaticResource PanelTitle}" Margin="0,12,0,0" />
                            <!-- Auto-renders one row per registered IFlowAlgorithm.
                                 Adding a new algorithm in AppServices grows this list
                                 without touching MainViewModel or XAML. -->
                            <ItemsControl ItemsSource="{Binding FlowAlgorithms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One row per registered algorithm. The Expander
                                             header has the Run button + summary; expanded
                                             content is an implicit DataTemplate matched
                                             on the Parameters' concrete type (defined in
                                             Views/FlowAlgorithmTemplates.xaml). -->
                                        <!--
                                          Each row is a header (color chip + Run + Summary + toggle) and a
                                          collapsible body. We avoid WPF Expander on purpose - its built-in
                                          chevron RotateTransform calls Matrix.CreateRotationRadians during
                                          the first layout pass which triggers an FP-inexact SEH under VS
                                          native debugging and crashes the process (0xC0000005 in JIT code).
                                          A plain ToggleButton + Visibility binding doesn't go through
                                          any rotation/animation path.
                                        -->
                                        <StackPanel Margin="0,2,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <!-- OK/NG color chip: bound directly to a Brush computed
                                                     on the runner. No DataTrigger / IValueConverter
                                                     evaluation on the layout-critical path. -->
                                                <Border Grid.Column="0"
                                                        Width="10" Height="10"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding OkNgBrush}" />
                                                <Button Grid.Column="1"
                                                        Content="{Binding DisplayName}"
                                                        Command="{Binding RunCommand}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Summary}"
                                                           Text="{Binding Summary}" />
                                                <!-- Two-state toggle (+ / -). No RotateTransform / Storyboard. -->
                                                <ToggleButton Grid.Column="3"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              FontFamily="Consolas">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Content" Value="+" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Content" Value="-" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- Collapsible body. Visibility binding uses WPF's built-in
                                                 BooleanToVisibilityConverter (no custom converter call). -->
                                            <StackPanel Margin="20,4,0,8"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ContentPresenter Content="{Binding Parameters}" />

                                                <TextBlock Text="LAST RESULT FIELDS"
                                                           Margin="0,10,0,2"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedText}" />

                                                <ItemsControl ItemsSource="{Binding LastResult.Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Key}"
                                                                           Foreground="{DynamicResource MutedText}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           FontFamily="Consolas"
                                                                           Foreground="{DynamicResource PrimaryText}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
