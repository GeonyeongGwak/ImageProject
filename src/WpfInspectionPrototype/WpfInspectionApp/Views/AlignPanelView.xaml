<UserControl x:Class="WpfInspectionApp.Views.AlignPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RightPanelBorder" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
                    <Border x:Name="AlignPanel" Style="{StaticResource RightPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="ALIGN ALGORITHM" Style="{StaticResource PanelTitle}" />
                            <TabControl x:Name="AlignTabControl" SelectionChanged="AlignTabControl_SelectionChanged">
                                <TabItem Header="Search">
                                    <StackPanel Margin="0,8,0,0">
                                         <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Search Num" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="SearchNumCombo"
                                                      Grid.Column="1"
                                                      SelectedValuePath="Content"
                                                      SelectedValue="{Binding SearchNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="SearchNumCombo_SelectionChanged">
                                                <ComboBoxItem Content="1" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="3" />
                                                <ComboBoxItem Content="4" IsSelected="True" />
                                            </ComboBox>
                                            <Button x:Name="ActiveRoiButton" Grid.Column="2" Content="{Binding ActiveRoiText}" Command="{Binding ActiveRoiCommand}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#3CFF50" CornerRadius="3" Padding="6,4" Margin="0,0,6,0">
                                                <TextBlock Text="Binary ROI" Foreground="#06111C" FontWeight="Bold" />
                                            </Border>
                                             <Button x:Name="DrawRoiButton" Grid.Column="1" Content="{Binding DrawWindowRoiText}" Background="{Binding DrawWindowRoiBrush}" Command="{Binding DrawWindowRoiCommand}" />
                                             <TextBlock Grid.Column="2" Text="Original px" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                         </Grid>

                                        <Button x:Name="DrawAlignAlgorithmRoiButton"
                                                Content="Draw Algorithm ROI"
                                                Margin="0,0,0,8"
                                                Command="{Binding DrawAlgorithmRoiCommand}" />

                                         <TextBlock x:Name="RoiText"
                                                   Margin="0,0,0,8"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding RoiText}" />

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shortcut" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Column="1" Text="A: Draw Current     S: Next ROI / Draw     Del: Delete ROI" Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#3CFF50" CornerRadius="3" Padding="6,4" Margin="0,0,6,0">
                                                <TextBlock Text="Search Margin" Foreground="#06111C" FontWeight="Bold" />
                                            </Border>
                                            <TextBox x:Name="SearchMarginBox"
                                                     Grid.Column="1"
                                                     Text="{Binding SearchMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="SearchParameter_Changed" />
                                            <TextBlock Grid.Column="2" Text="Pixel" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>

                                        <CheckBox x:Name="SameSizeCheck" Content="Same Size" IsChecked="{Binding SameSize, Mode=TwoWay}" Checked="SearchParameter_Changed" Unchecked="SearchParameter_Changed" />

                                        <Grid Margin="0,2,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FFD229" CornerRadius="3" Padding="6,4" Margin="0,0,6,0">
                                                <TextBlock Text="Search Size X" Foreground="#06111C" FontWeight="Bold" />
                                            </Border>
                                            <TextBox x:Name="SearchSizeXBox"
                                                     Grid.Column="1"
                                                     Text="{Binding SearchSizeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="SearchSizeBox_TextChanged" />
                                            <Button Grid.Column="2" Content="Teach" Command="{Binding TeachCommand}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FFD229" CornerRadius="3" Padding="6,4" Margin="0,0,6,0">
                                                <TextBlock Text="Search Size Y" Foreground="#06111C" FontWeight="Bold" />
                                            </Border>
                                            <TextBox x:Name="SearchSizeYBox"
                                                     Grid.Column="1"
                                                     Text="{Binding SearchSizeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="SearchSizeBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="BW Condition">
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="Use2DCheck" Content="Use 2D" IsChecked="{Binding Use2D, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="2D THR" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Threshold2D, Mode=TwoWay}" IsEnabled="{Binding Use2D}" TickFrequency="1" ValueChanged="ThresholdSlider_ValueChanged" />
                                            <TextBlock x:Name="ThresholdValueText" Grid.Column="2" Text="{Binding Threshold2DText}" Foreground="{DynamicResource AccentYellow}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <CheckBox x:Name="Use3DCheck" Content="Use 3D" IsChecked="{Binding Use3D, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="3D THR" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="Threshold3DSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Threshold3D, Mode=TwoWay}" IsEnabled="{Binding Use3D}" TickFrequency="1" ValueChanged="Threshold3DSlider_ValueChanged" />
                                            <TextBlock x:Name="Threshold3DValueText" Grid.Column="2" Text="{Binding Threshold3DText}" Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <CheckBox x:Name="UseEdgeCheck" Content="Use Edge" IsChecked="{Binding UseEdge, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="EDGE" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="EdgeGainSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EdgeGain, Mode=TwoWay}" IsEnabled="{Binding UseEdge}" TickFrequency="1" ValueChanged="EdgeGainSlider_ValueChanged" />
                                            <TextBlock x:Name="EdgeGainValueText" Grid.Column="2" Text="{Binding EdgeGainText}" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Padding="8" BorderBrush="{DynamicResource BorderBlue}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource ComboDarkBackground}">
                                            <Grid>
                                                <TextBlock Text="MASK DENSITY" Foreground="{DynamicResource MutedText}" />
                                                <TextBlock x:Name="MaskDensityText" HorizontalAlignment="Right" Text="{Binding MaskDensityText}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Inspection">
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="ShiftCheck" Content="Shift" IsChecked="{Binding ShiftEnabled, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shift X" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ShiftXBox" Grid.Column="1" Text="{Binding ShiftX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="AlignParameter_Changed" />
                                            <TextBlock Grid.Column="2" Text="mm" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="3" Text="Shift Y" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ShiftYBox" Grid.Column="4" Text="{Binding ShiftY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="AlignParameter_Changed" />
                                            <TextBlock Grid.Column="5" Text="mm" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="4,0" />
                                        </Grid>

                                        <CheckBox x:Name="AngleCheck" Content="Angle" IsChecked="{Binding AngleEnabled, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Angle" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AngleBox" Grid.Column="1" Text="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="AlignParameter_Changed" />
                                            <TextBlock Grid.Column="2" Text="deg" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="4,0" />
                                            <CheckBox x:Name="FillHoleCheck" Grid.Column="3" Content="Fill Hole" IsChecked="{Binding FillHole, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Filter" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="FilterBox" Grid.Column="1" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="AlignParameter_Changed" />
                                            <TextBlock Grid.Column="2" Text="pix" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="4,0" />
                                        </Grid>

                                        <CheckBox x:Name="InspectionAreaCountCheck" Content="Inspection Area Cnt" IsChecked="{Binding InspectionAreaCount, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="IPC">
                                    <StackPanel Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="IpcUseCheck" Content="Use" IsChecked="{Binding IpcUse, Mode=TwoWay}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                                            <ComboBox x:Name="IpcClassCombo"
                                                      Grid.Column="1"
                                                      SelectedValuePath="Content"
                                                      SelectedValue="{Binding IpcClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="IpcClassCombo_SelectionChanged">
                                                <ComboBoxItem Content="Class2" IsSelected="True" />
                                                <ComboBoxItem Content="Class1" />
                                                <ComboBoxItem Content="Class3" />
                                            </ComboBox>
                                            <TextBox x:Name="IpcPercentBox" Grid.Column="2" Text="{Binding IpcPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="AlignParameter_Changed" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="%" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Part Teaching">
                                    <StackPanel Margin="0,8,0,0">
                                        <ComboBox x:Name="PartTeachingLibraryMatchCombo"
                                                  SelectedValuePath="Content"
                                                  SelectedValue="{Binding PartTeachingLibraryMatchMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="PartTeachingOption_Changed">
                                            <ComboBoxItem Content="None" />
                                            <ComboBoxItem Content="CAD Match" />
                                            <ComboBoxItem Content="CAD Match No Message" />
                                        </ComboBox>

                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                            <CheckBox x:Name="PartTeachingCommonCheck"
                                                      Content="Common Library"
                                                      IsChecked="{Binding PartTeachingUseCommonLibrary, Mode=TwoWay}"
                                                      Checked="PartTeachingOption_Changed"
                                                      Unchecked="PartTeachingOption_Changed" />
                                            <CheckBox x:Name="PartTeachingLibraryCheck"
                                                      Content="Library Part"
                                                      IsChecked="{Binding PartTeachingUseLibraryPart, Mode=TwoWay}"
                                                      Checked="PartTeachingOption_Changed"
                                                      Unchecked="PartTeachingOption_Changed" />
                                            <CheckBox x:Name="PartTeachingAutoCheck"
                                                      Content="Teaching"
                                                      IsChecked="{Binding PartTeachingUseAutoTeaching, Mode=TwoWay}"
                                                      Checked="PartTeachingOption_Changed"
                                                      Unchecked="PartTeachingOption_Changed" />
                                            <CheckBox x:Name="PartTeachingMatchingCheck"
                                                      Content="Matching"
                                                      IsChecked="{Binding PartTeachingUseCadMatching, Mode=TwoWay}"
                                                      Checked="PartTeachingOption_Changed"
                                                      Unchecked="PartTeachingOption_Changed" />
                                        </UniformGrid>

                                        <UniformGrid Columns="3" Margin="0,10,0,0">
                                            <Button x:Name="PartTeachingIcButton"
                                                    Content="IC"
                                                    Visibility="{Binding PartTeachingIcVisibility}"
                                                    Command="{Binding PartTeachingIcCommand}" />
                                            <Button x:Name="PartTeachingOkButton"
                                                    Content="OK"
                                                    Visibility="{Binding PartTeachingOkVisibility}"
                                                    Command="{Binding PartTeachingOkCommand}" />
                                            <Button x:Name="PartTeachingCloseButton"
                                                    Content="Close"
                                                    Command="{Binding PartTeachingCloseCommand}" />
                                        </UniformGrid>

                                        <TextBlock x:Name="PartTeachingStatusText"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource MutedText}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding PartTeachingStatus}" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

</UserControl>
