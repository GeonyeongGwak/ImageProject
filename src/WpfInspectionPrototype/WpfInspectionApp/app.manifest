<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1" xmlns:asmv2="urn:schemas-microsoft-com:asm.v2" xmlns:dsig="http://www.w3.org/2000/09/xmldsig#">
  <assemblyIdentity version="1.0.0.0" name="WpfInspectionApp.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!--
    Native.PEM3DControlWrapper SxS dependency removed. The Windows loader processes
    this BEFORE any managed code (before ModuleInitializer), and the COM/OCX activation
    is suspected of triggering the FPU exception unmask that crashes WPF startup under
    VS native debugging. Restore the <dependency>...</dependency> block once the
    PEM3D viewer is needed again.
  -->
</assembly>
